# Required — at least one LLM provider
Anthropic_API_Key=sk-ant-...
OpenAI_API_Key=sk-proj-...
GEMINI_API_Key=AIza...

# Optional — OpenAI-compatible provider (Together AI, OpenRouter, etc.) for Qwen/other models
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPAT_MODEL=Qwen/Qwen3-235B-A22B

# Optional — Unsplash for stock photo fetching
UNSPLASH_ACCESS_KEY=

# Budget cap per content piece (USD)
CMSBOT_BUDGET_CAP=75.00

# Max refinement rounds (default 5)
CMSBOT_MAX_ROUNDS=5

# Optional — SEO / analytics overrides
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GSC_SITE_URL=
GA4_PROPERTY_ID=
BLOG_API_URL=
GA4_CONVERSION_EVENT=sign_up
